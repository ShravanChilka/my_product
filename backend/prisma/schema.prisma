generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int       @id @default(autoincrement())
    name      String
    email     String    @unique
    password  String
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt
    deletedAt DateTime?
}

model MaterialCategory {
    id        Int                @id @default(autoincrement())
    name      String             @unique
    parentId  Int?
    parent    MaterialCategory?  @relation("ParentChild", fields: [parentId], references: [id])
    children  MaterialCategory[] @relation("ParentChild")
    materials Material[]
    createdAt DateTime           @default(now())
    updatedAt DateTime?          @updatedAt
    deletedAt DateTime?
}

model MaterialBrand {
    id          Int        @id @default(autoincrement())
    name        String     @unique
    description String?
    logoURL     String
    createdAt   DateTime   @default(now())
    updatedAt   DateTime?  @updatedAt
    deletedAt   DateTime?
    materials   Material[]
}

model Location {
    id          Int          @id @default(autoincrement())
    code        String       @unique
    name        String       @unique
    type        LocationType @default(warehouse)
    address     String
    parentId    Int?
    parent      Location?    @relation("ParentChild", fields: [parentId], references: [id])
    children    Location[]   @relation("ParentChild")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime?    @updatedAt
    deletedAt   DateTime?
    inventories Inventory[]
}

enum LocationType {
    warehouse
    store
    vendor
    bin
}

model PackageType {
    id               Int               @id @default(autoincrement())
    name             String            @unique
    description      String?
    createdAt        DateTime          @default(now())
    updatedAt        DateTime?
    deletedAt        DateTime?
    materialPackages MaterialPackage[]
}

model UnitOfMeasure {
    id               Int           @id @default(autoincrement())
    name             String        @unique
    abbreviation     String        @unique
    createdAt        DateTime      @default(now())
    updatedAt        DateTime?     @updatedAt
    deletedAt        DateTime?
    materials        Material[]
    packageUnits     PackageSize[] @relation("PackageUnit")
    basePackageUnits PackageSize[] @relation("BasePackageUnit")
}

model PackageSize {
    id                  Int               @id @default(autoincrement())
    size                Float
    unitOfMeasureId     Int
    unitOfMeasure       UnitOfMeasure     @relation("PackageUnit", fields: [unitOfMeasureId], references: [id])
    baseUnitOfMeasureId Int
    baseUnitOfMeasure   UnitOfMeasure     @relation("BasePackageUnit", fields: [baseUnitOfMeasureId], references: [id])
    conversionFactor    Float             @default(1)
    createdAt           DateTime          @default(now())
    updatedAt           DateTime?
    deletedAt           DateTime?
    materialPackages    MaterialPackage[]

    @@unique([size, unitOfMeasureId])
}

model Material {
    id              Int               @id @default(autoincrement())
    name            String            @unique
    sku             String            @unique
    description     String?
    unitOfMeasureId Int
    unitOfMeasure   UnitOfMeasure     @relation(fields: [unitOfMeasureId], references: [id])
    categoryId      Int
    category        MaterialCategory  @relation(fields: [categoryId], references: [id])
    brandId         Int
    brand           MaterialBrand     @relation(fields: [brandId], references: [id])
    isActive        Boolean           @default(true)
    createdAt       DateTime          @default(now())
    updatedAt       DateTime?         @updatedAt
    deletedAt       DateTime?
    MaterialPackage MaterialPackage[]
}

model MaterialPackage {
    id            Int         @id @default(autoincrement())
    materialId    Int
    material      Material    @relation(fields: [materialId], references: [id])
    packageTypeId Int
    packageType   PackageType @relation(fields: [packageTypeId], references: [id])
    packageSizeId Int
    packageSize   PackageSize @relation(fields: [packageSizeId], references: [id])
    sku           String      @unique
    barcode       String?
    isActive      Boolean     @default(true)
    inventories   Inventory[]
    createdAt     DateTime    @default(now())
    updatedAt     DateTime?   @updatedAt
    deletedAt     DateTime?

    @@unique([materialId, packageTypeId, packageSizeId])
}

model Inventory {
    id                Int             @id @default(autoincrement())
    materialPackageId Int
    materialPackage   MaterialPackage @relation(fields: [materialPackageId], references: [id])
    locationId        Int
    location          Location        @relation(fields: [locationId], references: [id])
    quantity          Float           @default(0)
    reservedQuantity  Float           @default(0)
    thresholdQuantity Float           @default(0)
    createdAt         DateTime        @default(now())
    updatedAt         DateTime?       @updatedAt
    deletedAt         DateTime?

    @@unique([materialPackageId, locationId])
}
