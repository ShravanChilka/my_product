generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int       @id @default(autoincrement())
    name      String    @unique
    email     String    @unique
    password  String
    createdAt DateTime  @default(now())
    updatedAt DateTime?
    deletedAt DateTime?
}

model Material {
    id               Int            @id @default(autoincrement())
    name             String         @unique
    sku              String         @unique
    description      String?
    unitsOfMeasureId Int
    unitOfMeasure    UnitsOfMeasure @relation(fields: [unitsOfMeasureId], references: [id])
    categoryId       Int
    category         Category       @relation(fields: [categoryId], references: [id])
    isActive         Boolean        @default(true)
    createdAt        DateTime       @default(now())
    updatedAt        DateTime?
    deletedAt        DateTime?
}

model UnitsOfMeasure {
    id           Int        @id @default(autoincrement())
    name         String     @unique
    abbreviation String     @unique
    materials    Material[]
}

model Category {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    parentId  Int?
    parent    Category?  @relation("ParentChild", fields: [parentId], references: [id])
    children  Category[] @relation("ParentChild")
    materials Material[]
}
