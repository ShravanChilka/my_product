generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int       @id @default(autoincrement())
    name      String
    email     String    @unique
    password  String
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt
    deletedAt DateTime?
}

model Material {
    id              Int              @id @default(autoincrement())
    name            String           @unique
    sku             String           @unique
    description     String?
    unitOfMeasureId Int
    unitOfMeasure   UnitOfMeasure    @relation(fields: [unitOfMeasureId], references: [id])
    categoryId      Int
    category        MaterialCategory @relation(fields: [categoryId], references: [id])
    brandId         Int
    brand           MaterialBrand    @relation(fields: [brandId], references: [id])
    isActive        Boolean          @default(true)
    createdAt       DateTime         @default(now())
    updatedAt       DateTime?        @updatedAt
    deletedAt       DateTime?
    inventories     Inventory[]
}

model UnitOfMeasure {
    id           Int        @id @default(autoincrement())
    name         String     @unique
    abbreviation String     @unique
    materials    Material[]
    createdAt    DateTime   @default(now())
    updatedAt    DateTime?  @updatedAt
    deletedAt    DateTime?
    // packagingUnits     PackagingType[] @relation("PackagingUnit")
    // packagingBaseUnits PackagingType[] @relation("PackagingBaseUnit")
}

model MaterialCategory {
    id        Int                @id @default(autoincrement())
    name      String             @unique
    parentId  Int?
    parent    MaterialCategory?  @relation("ParentChild", fields: [parentId], references: [id])
    children  MaterialCategory[] @relation("ParentChild")
    materials Material[]
    createdAt DateTime           @default(now())
    updatedAt DateTime?          @updatedAt
    deletedAt DateTime?
}

model MaterialBrand {
    id          Int        @id @default(autoincrement())
    name        String     @unique
    description String?
    logoURL     String
    createdAt   DateTime   @default(now())
    updatedAt   DateTime?  @updatedAt
    deletedAt   DateTime?
    materials   Material[]
}

model Location {
    id          Int          @id @default(autoincrement())
    code        String       @unique
    name        String       @unique
    type        LocationType @default(warehouse)
    address     String
    parentId    Int?
    parent      Location?    @relation("ParentChild", fields: [parentId], references: [id])
    children    Location[]   @relation("ParentChild")
    createdAt   DateTime     @default(now())
    updatedAt   DateTime?    @updatedAt
    deletedAt   DateTime?
    inventories Inventory[]
}

enum LocationType {
    warehouse
    store
    vendor
    bin
}

model Inventory {
    id                Int       @id @default(autoincrement())
    materialId        Int
    material          Material  @relation(fields: [materialId], references: [id])
    locationId        Int
    location          Location  @relation(fields: [locationId], references: [id])
    quantity          Int       @default(0)
    reservedQuantity  Int       @default(0)
    thresholdQuantity Int       @default(0)
    createdAt         DateTime  @default(now())
    updatedAt         DateTime? @updatedAt
    deletedAt         DateTime?

    @@unique([materialId, locationId])
}

model UnitType {
    id          Int       @id @default(autoincrement())
    name        String    @unique
    description String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime?
    deletedAt   DateTime?
}

